# Copy this file to .env and fill in your own values.
# .env is gitignored — real secrets are safe to put in it.
# Every value here is just a starting point: all of these are still
# editable in the page itself after it loads.

# Port the local server listens on.
PORT=8080

# Optional: prefills the Claude API key field (cloud provider mode).
# Leave blank to type it into the page instead.
CLAUDE_API_KEY=

# Prefills the local model (LM Studio) settings.
LMSTUDIO_URL=http://localhost:1234/v1/chat/completions
LMSTUDIO_MODEL=qwen/qwen3.8-27b
LMSTUDIO_TOKEN=

# Optional: pin the Claude Code bridge token instead of generating a new
# random one every time the server starts.
BRIDGE_TOKEN=

# Optional: a Whisper-compatible transcription server (OpenAI-style
# /v1/audio/transcriptions endpoint) for the "capture call audio"
# feature — server.js's own client settings for reaching it. Not needed
# for anything else in the app.
WHISPER_URL=http://localhost:8000/v1/audio/transcriptions
WHISPER_MODEL=whisper-1
WHISPER_TOKEN=

# The rest of this file is read directly by transcribe_server.py itself
# (the bundled local Whisper server), not by server.js.
#
# Model size: tiny/base/small/medium/distil-large-v3/large-v3 — bigger is
# slower but more accurate. distil-large-v3 (the default) is close to
# large-v3 accuracy at a fraction of the cost, and light enough on VRAM
# to share a GPU with a large LLM.
WHISPER_MODEL_SIZE=distil-large-v3
# cuda (default) or cpu. Falls back to cpu automatically if no usable
# GPU is found, so this rarely needs changing.
WHISPER_DEVICE=cuda
# float16 is the default on cuda, int8 on cpu — leave blank to use that
# default, or override explicitly.
WHISPER_COMPUTE_TYPE=
